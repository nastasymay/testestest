{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kontur-research",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kontur-research",
      "database_id": "15c0a949-fd13-4a81-a496-2883016dcf4f",
      "migrations_dir": "migrations"
    }
  ]
}
